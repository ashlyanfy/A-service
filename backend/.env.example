# Database — SQLite для разработки, PostgreSQL в проде:
# DATABASE_URL=postgresql+asyncpg://aservice:aservice@localhost:5432/aservice
DATABASE_URL=sqlite+aiosqlite:///./aservice.db

# JWT — обязательно сменить в проде (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS: адреса админки и лендинга
CORS_ORIGINS=http://localhost:3000,http://localhost:8734,https://crm.a-service.asia,https://a-service.asia

# Адрес админки (ссылки в письмах сброса пароля)
ADMIN_URL=https://crm.a-service.asia

# Вложения заявок
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# VAPID (Web Push) — сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:haba-87@mail.ru

# SMTP (восстановление пароля)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=A-SERVICE CRM <no-reply@a-service.asia>
SMTP_USE_TLS=true

# Telegram-уведомления о заявках
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# production | development
ENV=development

# Первичный админ (используется только скриптом app.seed)
SEED_ADMIN_EMAIL=admin@a-service.asia
SEED_ADMIN_PASSWORD=ChangeMe123!
