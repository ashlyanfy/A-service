web: if command -v python >/dev/null 2>&1; then if [ -f src/build.py ]; then python src/build.py || echo '[start] site not rebuilt, using committed frontend/'; fi; if [ -d backend ]; then cd backend; fi; python -m app.seed || echo '[start] seed failed, API may return errors until DB is ready'; exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}; elif [ -f /app/Caddyfile ]; then echo '[start] python not found: serving static files only. Set service Root Directory to / to get the API and site analytics.'; exec caddy run --config /app/Caddyfile --adapter caddyfile; else echo '[start] neither python nor caddy available'; exit 1; fi
